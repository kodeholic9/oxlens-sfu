#!/bin/sh
# author: kodeholic (powered by Claude)
# spec: 마스터 §시험 체계 — 서버를 바꾼 push 는 그 빌드의 3층 통과 기록(oxlens-sdk-web/.archive/gate-live/latest.json)이 있어야 나간다
top=$(git rev-parse --show-toplevel)
rec="$top/../oxlens-sdk-web/.archive/gate-live/latest.json"
zero=0000000000000000000000000000000000000000
need=0
while read lref lsha rref rsha; do
  [ "$lsha" = "$zero" ] && continue
  # ★annotated 태그는 태그 객체 SHA 로 온다 — 가리키는 커밋으로 푼다(20261025 v1.2 태그 push 가 태그 객체를 빌드로 견줘 거절됐다)
  lsha=$(git rev-parse "$lsha^{commit}" 2>/dev/null || echo "$lsha")
  if [ "$rsha" = "$zero" ]; then range="$lsha^!"; else range="$rsha..$lsha"; fi
  # ★대조 대상은 push 하는 커밋이다(HEAD 가 아니다 — 앞 커밋까지만 올리는 push 도 있다 · 20261023)
  git diff --name-only $range -- crates Cargo.toml Cargo.lock 2>/dev/null | grep -q . && need=1 && want="$want $(git rev-parse --short=12 $lsha)"
done
[ "$need" = 0 ] && exit 0
python3 - "$rec" $want <<'PY'
import json, sys
path, wants = sys.argv[1], sys.argv[2:]
try:
    r = json.load(open(path))
except Exception:
    print(f"✗ push 거절 — 3층 기록이 없다: {path}\n  oxlens-sdk-web 에서 `OXE2E_HUB=… npm run gate:live` 를 이 빌드로 돌린다")
    sys.exit(1)
b = r.get("server_build") or ""
for head in wants:
  if not r.get("passed") or not b.startswith(head) or "-dirty" in b:
    print(f"✗ push 거절 — 이 빌드({head})의 3층 통과 기록이 아니다: passed={r.get('passed')} server_build={b!r} at={r.get('at')}\n"
          f"  서버를 이 커밋으로 띄우고 oxlens-sdk-web 에서 `npm run gate:live` 를 다시 돌린다")
    sys.exit(1)
print(f"✓ 3층 통과 기록 확인 — server {b} · {r.get('at')}")
PY
